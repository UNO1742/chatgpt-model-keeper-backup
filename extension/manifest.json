{
  "manifest_version": 3,
  "name": "ChatGPT 模型锁定器",
  "version": "2.5.1",
  "description": "聊天与工作分别使用预设模型及思考程度，中英文适配。配合本机设置程序使用。",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
